    },
    "runs": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "created_at",
          "scope",
          "fresh",
          "items"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "extensions": {
            "type": "object"
          },
          "created_at": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "object"
          },
          "fresh": {
            "type": "boolean"
          },
          "items": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "reason",
                "basis"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "pending",
                    "reused",
                    "blocked",
                    "unlinked",
                    "completed"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "basis": {
                  "type": "object"
                },
                "review_id": {
                  "type": "string",
                  "minLength": 1
                },
                "missing": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
